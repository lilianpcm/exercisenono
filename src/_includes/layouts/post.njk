---
layout: layouts/base.njk
---
{% import "components.njk" as c %}
{% set cat = catalog.categories[category] %}
{% set prod = catalog.products[product] if product else null %}
{% set parts = content.split("<!--cta-->") %}
{% set list = exercises or [] %}
{% set mid = cta_after or 4 %}
{% if mid > list.length %}{% set mid = list.length %}{% endif %}
{% include "partials/breadcrumbs.njk" %}
<article>
  <header class="prose page-head">
    {{ c.catPill(cat) }}
    <h1>{{ title }}</h1>
    <p class="promise">{{ promise or description }}</p>
    {% include "partials/meta.njk" %}
  </header>
  {% if hero_image %}
  <figure class="prose post-hero">
    {{ img(hero_image, hero_alt or title, { widths: [480, 720, 1080, 1360], sizes: "(min-width: 760px) 680px, 92vw", eager: true }) | safe }}
  </figure>
  {% endif %}
  <div class="prose">
    {{ c.takeaways(key_takeaways) }}
    <div class="content">
{{ parts[0] | safe }}
    </div>
    {{ c.disclaimer(safety_note) }}

    {% if list.length %}
    <h2 id="exercises">{{ exercises_heading or "The exercises" }}</h2>
    <ol class="ex-list">
      {% for e in list %}{% if loop.index <= mid %}<li>{{ c.exCard(catalog.exercises[e.ref], loop.index, e.dose, e.note, audience) }}</li>{% endif %}{% endfor %}
    </ol>
    {% if prod %}{{ c.cta(prod, page.fileSlug, "cta-mid") }}{% endif %}
    {% if list.length > mid %}
    <ol class="ex-list" start="{{ mid + 1 }}">
      {% for e in list %}{% if loop.index > mid %}<li>{{ c.exCard(catalog.exercises[e.ref], loop.index, e.dose, e.note, audience) }}</li>{% endif %}{% endfor %}
    </ol>
    {% endif %}
    {% elif prod and parts.length > 1 %}
    {{ c.cta(prod, page.fileSlug, "cta-mid") }}
    {% endif %}

    {% if parts.length > 1 %}
    <div class="content">
{{ parts[1] | safe }}
    </div>
    {% endif %}

    {{ c.faq(faq) }}
    {% if prod %}{{ c.cta(prod, page.fileSlug, "cta-final") }}{% endif %}

    {% if pin_image %}
    <figure class="pinbox">
      <figcaption class="label" style="margin-bottom:10px">Save this guide for later</figcaption>
      {{ img(pin_image, pin_alt or title, { widths: [340, 680, 1000], sizes: "340px", extra: 'data-pin-description="' + description + '"' }) | safe }}
    </figure>
    {% endif %}

    {{ c.sources(sources) }}
  </div>

  {% set others = [] %}
  {% for p in catalog.posts %}{% if p.slug != page.fileSlug and ((related and related.length and p.slug in related) or (not (related and related.length) and p.category == category)) and others.length < 3 %}{% set _ = others.push(p) %}{% endif %}{% endfor %}
  <section class="band" aria-labelledby="related-h" style="margin-top:var(--space-5)">
    <div class="wrap">
      {% if others.length %}
      <h2 id="related-h">Related guides</h2>
      <ul class="grid grid--3" style="margin-top:var(--space-3)">{% for p in others %}<li>{{ c.postCard(p) }}</li>{% endfor %}</ul>
      {% else %}<h2 id="related-h" class="vh">More</h2>{% endif %}
      <p style="margin:var(--space-3) 0 0"><a class="btn-ghost" href="{{ cat.url }}">All {{ cat.name }} guides {{ icon("arrow-right") | safe }}</a></p>
    </div>
  </section>
</article>
